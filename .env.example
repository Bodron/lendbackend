PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lend
MONGODB_DB=lend
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

BUCKET_NAME=your-s3-bucket
BUCKET_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional if you use CloudFront or another public CDN.
AWS_S3_PUBLIC_BASE_URL=
# Used when AWS_S3_PUBLIC_BASE_URL is empty and the bucket is private.
AWS_S3_SIGNED_URL_TTL_SECONDS=3600

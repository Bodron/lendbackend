PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lend
MONGODB_DB=lend
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
# Bundle ID or Services ID configured for Sign in with Apple.
# Use comma-separated values if iOS and web/Android use different client IDs.
APPLE_CLIENT_IDS=com.example.lend
# OAuth Client IDs accepted for Google Sign-In ID tokens.
# Include iOS, Android debug/sandbox, and Web client IDs when applicable.
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-debug-client-id.apps.googleusercontent.com

BUCKET_NAME=your-s3-bucket
BUCKET_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional if you use CloudFront or another public CDN.
AWS_S3_PUBLIC_BASE_URL=
# Used when AWS_S3_PUBLIC_BASE_URL is empty and the bucket is private.
AWS_S3_SIGNED_URL_TTL_SECONDS=3600
